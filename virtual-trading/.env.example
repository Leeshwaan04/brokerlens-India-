# Copy to .env.local for local development. Real values are provisioned
# separately (Neon Postgres and Clerk, both via the Vercel Marketplace) and
# are never committed.

# Neon Postgres connection string (Vercel Marketplace > Neon > connection details)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clerk (Vercel Marketplace > Clerk, or dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Clerk webhook signing secret, from the Clerk dashboard's Webhooks page
# (endpoint: /api/webhooks/clerk, subscribed to the user.created event)
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxx"

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when it
# calls /api/cron/sync-eod-prices. Vercel sets this automatically for Cron
# Jobs on deployments that define CRON_SECRET; set the same value locally to
# test the route by hand.
CRON_SECRET="change-me"
