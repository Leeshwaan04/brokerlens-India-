# Copy to .env.local for local development. Real values are provisioned
# separately (Neon Postgres at console.neon.tech and Clerk at dashboard.clerk.com)
# and are never committed.

# Neon Postgres connection string (console.neon.tech > Project > Connection Details)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clerk authentication (dashboard.clerk.com > API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Clerk webhook signing secret, from the Clerk dashboard's Webhooks page
# (endpoint: /api/webhooks/clerk, subscribed to the user.created event)
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxx"

# Shared secret sent as "Authorization: Bearer <value>" when triggering
# /api/cron/sync-eod-prices (e.g. from GitHub Actions schedule or Cloudflare Cron).
CRON_SECRET="change-me"

# ---------------------------------------------------------------------------
# Local development without Neon or Clerk accounts (ignored by any production
# build: see lib/session.ts and lib/db.ts).
#
# A localhost DATABASE_URL uses plain node-postgres instead of Neon, e.g.
#   DATABASE_URL="postgresql://<you>@localhost:5432/virtual_trading_dev"
# then: npx drizzle-kit migrate, npm run sync:broker-rates,
#       npm run seed:market-holidays, npm run sync:stock-universe,
#       and call /api/cron/sync-eod-prices?date=YYYY-MM-DD with CRON_SECRET.
#
# Sign in as a local user with no Clerk instance, or browse signed out:
# VT_DEV_AUTH_USER_ID="user_local_dev"
# VT_DEV_AUTH_USER_ID="signed-out"
# Stops Clerk creating a temporary "keyless" instance from your machine:
# NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true
