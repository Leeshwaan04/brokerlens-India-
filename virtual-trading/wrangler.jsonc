{
  "$schema": "node_modules/wrangler/config-schema.json",
  // BrokerLens Virtual Trading on Cloudflare Workers, built by
  // @opennextjs/cloudflare (npm run cf:build). See LAUNCH.md before the first
  // deploy: secrets come from `wrangler secret put`, never from this file.
  //
  // Production domain, added after the first deploy (LAUNCH.md step 8):
  //   "routes": [{ "pattern": "paper.brokerlens.in", "custom_domain": true }]
  "name": "brokerlens-paper",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Every page is per-user and rendered on request, so the app needs no
  // incremental cache (R2/KV), image binding or Durable Objects.
  //
  // The database (Supabase Postgres, Mumbai) through Hyperdrive, which pools
  // connections and verifies Supabase's certificate against its pinned root
  // (sslmode verify-full, CA "supabase-root-2021"). Query caching is off so a
  // page never shows an order or balance from before the user's last action.
  // lib/db.ts uses this binding on Workers and DATABASE_URL everywhere else.
  // For `npm run cf:preview`, set
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE to a local database.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ade55fc3221945f6a997d9525a371bc4"
    }
  ],
  "observability": {
    "enabled": true
  },
  // No per-version preview URLs: they would expose every uploaded version,
  // cron and webhooks included, on a second public address. Turn workers_dev
  // off too once paper.brokerlens.in serves the app (LAUNCH.md step 7).
  "preview_urls": false,
  // Served only at paper.brokerlens.in: Cloudflare created its DNS record and
  // certificate. Not on *.workers.dev, which would be a second public copy.
  "routes": [{ "pattern": "paper.brokerlens.in", "custom_domain": true }],
  "workers_dev": false,
  "vars": {
    // Days the practice market runs behind the real one. Only lower on legal advice.
    "VT_PRICE_LAG_DAYS": "30",
    // Canonical URLs, the sitemap and Clerk's authorised origin.
    "NEXT_PUBLIC_APP_URL": "https://paper.brokerlens.in",
    // Clerk production instance "Brokerlens" (secondary application on
    // paper.brokerlens.in, Frontend API clerk.paper.brokerlens.in). The
    // publishable key is public; NEXT_PUBLIC_* values are also inlined at
    // build time, so build with the same values in the environment.
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsucGFwZXIuYnJva2VybGVucy5pbiQ",
    // Signed-out visitors go to the app's own pages, not Clerk's hosted portal.
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up"
  }
}
