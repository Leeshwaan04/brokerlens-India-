#!/usr/bin/env bash
# Blocks a push if the QA or VAPT suite fails. Added after a missing brace in
# a client-side JS file shipped straight to production undetected - node
# --check on a plain .js doesn't validate ES module syntax, so nothing caught
# it before it broke the ticker, search and every mega-menu on every page.
#
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: running tests/qa_e2e.py and tests/vapt.py..."

if ! python3 tests/qa_e2e.py; then
  echo ""
  echo "pre-push: qa_e2e.py failed - push blocked. Fix the failures above, or"
  echo "          git push --no-verify to override (not recommended)."
  exit 1
fi

if ! python3 tests/vapt.py; then
  echo ""
  echo "pre-push: vapt.py failed - push blocked. Fix the findings above, or"
  echo "          git push --no-verify to override (not recommended)."
  exit 1
fi

echo "pre-push: all clear."
