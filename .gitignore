# Generated / internal state - never commit.
# NOTE: gitignore has no trailing-comment syntax; comments must be on their own line.
data/cache/
data/raw/
data/canonical/

# 1MB of raw scraped exchange + regulator state. Internal, regenerable.
data/_ingest.json

# Published payloads; regenerate with `make all`.
site/*
!site/about/
!site/contact/
!site/editorial-policy/
!site/assets/
!site/privacy-policy/
!site/terms-of-service/
!site/news/
!site/crypto/
!site/index.html
!site/404.html
!site/manifest.json
!site/robots.txt
!site/favicon.ico
!site/apple-touch-icon.png
!site/icon-192.png
!site/icon-512.png
!site/_headers
!site/_redirects
!site/vercel.json
!site/sitemap.xml
!site/sitemaps/

# Personal data. Leads are DPDP-regulated and must never reach a repo.
data/leads/

# Service-account keys and other credentials. Never commit, never a build input path.
secrets/

__pycache__/
*.pyc
.DS_Store
*.log
.venv/
venv/
.claude/
dist/
*.zip
.vercel
.env*

# Theme music: not committed until the track's licence is confirmed. theme-audio.js hides the
# speaker button when the file is absent, so the site works without it.
site/assets/audio/*.mp3
*.mp3

# Raw source videos at the repo root (the optimised hero clip lives in site/assets/video/)
/*.mp4
